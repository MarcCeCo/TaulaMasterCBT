# ─── token-service ───────────────────────────────────────────────────────────
# Únic servei que renova el token APS (els refresh tokens d'Autodesk són d'un sol ús).

SUPABASE_URL=https://<PROJECT_ID>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>

APS_CLIENT_ID=<CLIENT_ID>
APS_CLIENT_SECRET=<CLIENT_SECRET>
# Ha de coincidir EXACTAMENT amb la Callback URL registrada a aps.autodesk.com
APS_CALLBACK_URL=https://<url-del-token-service>.onrender.com/auth/callback

# Secret que fan servir els serveis interns (Visor 3D) per demanar el token.
# Genera'l amb: openssl rand -hex 32   (el mateix valor va a visor3d)
TOKEN_SERVICE_SECRET=<SECRET_LLARG_ALEATORI>

# Orígens web autoritzats per CORS (separats per comes; sense barra final).
ALLOWED_ORIGINS=https://taula-master-cbt.vercel.app,http://localhost:5173

# ─── MODE BOT (recomanat): Secure Service Account "taulamaster_bot" ─────────
# Si aquestes tres variables hi són (juntament amb APS_CLIENT_ID i APS_CLIENT_SECRET),
# el servei fa servir el bot i ignora el flux d'usuari (/auth/login, aps_tokens).
# Si en falta alguna, torna al mode antic d'usuari.
APS_SSA_ID=<SERVICE_ID_DEL_BOT>
APS_SSA_KEY_ID=<KEY_ID_DE_LA_CLAU>
# Clau privada PEM. A Render pots enganxar-la tal qual (multilínia) o amb \n escapats.
APS_SSA_PRIVATE_KEY=<CLAU_PRIVADA_PEM>
