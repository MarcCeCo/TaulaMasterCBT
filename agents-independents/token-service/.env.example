# ─── token-service ───────────────────────────────────────────────────────────
# Únic servei que renova el token APS (els refresh tokens d'Autodesk són d'un sol ús).

SUPABASE_URL=https://<PROJECT_ID>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>

APS_CLIENT_ID=<CLIENT_ID>
APS_CLIENT_SECRET=<CLIENT_SECRET>
# Ha de coincidir EXACTAMENT amb la Callback URL registrada a aps.autodesk.com
APS_CALLBACK_URL=https://<url-del-token-service>.onrender.com/auth/callback

# Secret que fan servir els serveis interns (Visor 3D) per demanar el token.
# Genera'l amb: openssl rand -hex 32   (el mateix valor va a visor3d)
TOKEN_SERVICE_SECRET=<SECRET_LLARG_ALEATORI>
