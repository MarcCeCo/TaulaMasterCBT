# ─── visor3d (sincronització ACC → Supabase) ─────────────────────────────────

SUPABASE_URL=https://<PROJECT_ID>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>

APS_HUB_ID=<HUB_ID>
APS_PROJECT_ID=<PROJECT_ID>

# Bearer que GitHub Actions envia a POST /sync (cron mensual).
# El frontend NO el fa servir: el botó "Executar" envia la sessió de Supabase d'un admin.
# Genera'l amb: openssl rand -hex 32
AGENT_SECRET=<SECRET>

# El token APS ja NO es renova aquí: es demana al token-service.
TOKEN_SERVICE_URL=https://<url-del-token-service>.onrender.com
TOKEN_SERVICE_SECRET=<el mateix valor que a token-service>

# APS_CLIENT_ID i APS_CLIENT_SECRET ja no calen en aquest servei.
# (Si TOKEN_SERVICE_URL no està definit, torna al mode antic i els necessita.)

# Orígens web autoritzats per CORS (separats per comes; sense barra final).
ALLOWED_ORIGINS=https://taula-master-cbt.vercel.app,http://localhost:5173
