{
  "functions": {
    "api/index-embeddings.ts": {
      "maxDuration": 300
    },
    "api/groq-chat.ts": {
      "maxDuration": 60
    },
    "api/tag-lookup.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/bim-proxy/:path*",
      "destination": "https://besostordera.autodesk360.com/:path*"
    },
    {
      "source": "/((?!api|bim-proxy).*)",
      "destination": "/index.html"
    }
  ]
}
