# ─── Supabase ────────────────────────────────────────────────────────────────
# Troba aquests valors a: https://app.supabase.com → Settings → API
VITE_SUPABASE_URL=https://<PROJECT_ID>.supabase.co
VITE_SUPABASE_ANON_KEY=<ANON_KEY>

# ─── Com configurar-ho ────────────────────────────────────────────────────────
# 1. Copia aquest arxiu: cp .env.example .env.local
# 2. Substitueix els valors de Supabase
# 3. A Vercel: Settings → Environment Variables → afegeix les mateixes claus
# IMPORTANT: Mai pujis el .env.local a GitHub
